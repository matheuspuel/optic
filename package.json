    "@types/node": "^25.0.8",
    "@vitest/coverage-v8": "^5.0.4",
    "cross-env": "^7.0.3",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
