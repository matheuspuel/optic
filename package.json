{
  "name": "@matheuspuel/optic",
  "version": "0.3.0",
  "type": "module",
  "files": [
    "/dist",
    "/src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/dts/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "lint": "oxlint . --deny-warnings && prettier --check .",
    "lint:fix": "oxlint . --deny-warnings --fix && prettier --write .",
    "typecheck": "tsc",
    "test": "vitest",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test --run",
    "upload": "pnpm check && pnpm publish"
  },
  "dependencies": {
    "effect": "^4.0.3"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.4",
    "@effect/vitest": "^4.0.3",
    "@matheuspuel/optic": "file:.",
    "@types/node": "^25.0.8",
    "@vitest/coverage-v8": "^5.0.4",
    "cross-env": "^7.0.3",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
