  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheuspuel/optic.git"
  },
  "files": [
    "/dist",
    "/src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/dts/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
